{
  "name": "knowpod-desktop",
  "productName": "knowpod",
  "private": true,
  "version": "0.15.2",
  "description": "Your recorded conversations, transcribed and summarized.",
  "author": "knowpod",
  "homepage": "https://github.com/michaelkleinhenz/knowpod-service",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelkleinhenz/knowpod-service.git"
  },
  "desktopName": "knowpod.desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.kleinhenz.knowpod",
    "productName": "knowpod",
    "artifactName": "knowpod-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "knowpod",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "knowpod records voice memos with the microphone.",
        "NSAudioCaptureUsageDescription": "knowpod records what the computer plays when you record a video meeting.",
        "NSBluetoothAlwaysUsageDescription": "knowpod switches on the USB drive of your Pocket recorder and copies recordings from your knowpod recorder over Bluetooth."
      }
    },
    "publish": null
  }
}
