# Copy to .env and fill in. docker compose reads .env automatically; never commit .env.

# Default web UI login. After the password is changed in the UI, the stored password is
# used and ADMIN_PASSWORD no longer works for this account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional: bearer token for scripting the admin API without signing in.
ADMIN_TOKEN=

# Amazon S3 bucket for the audio files (must already exist).
AWS_S3_BUCKET_NAME=
AWS_S3_PREFIX=
AWS_DEFAULT_REGION=eu-central-1
# Leave empty when the host provides credentials another way (e.g. an instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
